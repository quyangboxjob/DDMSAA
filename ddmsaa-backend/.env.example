# バックエンドの環境変数（ローカル実行用のひな形）。複製して ddmsaa-backend/.env を作り、値を自分で決める。
# .env はコミットしない（.gitignore 済み）。秘密値（JWT_SECRET・AES_KEY・パスワード）は本番と共有しない。
# 一覧の正本：docs/基本設計/基盤/インタフェース仕様/spec-project-structure.yaml の env_vars。
# 例）JWT_SECRET の生成：openssl rand -base64 48　/　AES_KEY の生成：openssl rand -base64 32

# docker/.env の DB_USER / DB_PASSWORD と同じ値にする（PostgreSQL は localhost:5434）。
# business-service-core：SPRING_DATASOURCE_*　/　auth-service：DB_USERNAME・DB_PASSWORD（URL は application.yml 固定）

# --- api-gateway / auth-service / business-service-core
JWT_SECRET=change-me
# JWT_ISSUER=ddmsaa

# --- auth-service / business-service-core
# JWT_EXPIRATION_SECONDS=3600

# --- auth-service
# MAGIC_LINK_TTL_SECONDS=3600
# MAGIC_LINK_BASE_URL=http://localhost:3000/auth/verify
# MAIL_FROM=no-reply@ddmsaa.local
# DB_USERNAME=ddmsaa
DB_PASSWORD=change-me
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# MAIL_HOST=localhost
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# --- api-gateway
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# CORE_SERVICE_URI=http://localhost:8082

# --- api-gateway / business-service-core
# AUTH_SERVICE_URI=http://localhost:8081

# --- business-service-core
AES_KEY=change-me
# S3_REGION=ap-northeast-1
# S3_BUCKET=ddmsaa
# S3_PREFIX=
# S3_ENDPOINT=
# S3_PATH_STYLE=false
# S3_PRESIGN_TTL_SECONDS=300
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/ddmsaa?currentSchema=public
SPRING_DATASOURCE_USERNAME=ddmsaa
SPRING_DATASOURCE_PASSWORD=change-me
