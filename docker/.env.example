# docker/.env のひな形。複製して docker/.env を作り、パスワードを自分で決める（docker/.env はコミットしない）。

# PostgreSQL スーパーユーザー（postgres）のパスワード。初期化専用。
POSTGRES_PASSWORD=change-me-superuser

# 業務接続ユーザー・DB（バックエンドの DB_USERNAME / DB_PASSWORD、SPRING_DATASOURCE_* に同じ値を使う）
DB_NAME=ddmsaa
DB_USER=ddmsaa
DB_PASSWORD=change-me-app

# 開発用サンプルデータ（21_seed_sample.sql）を投入するか（初回起動時のみ有効）
SEED_SAMPLE_DATA=true

# ホスト側ポート（PostgreSQL は 5434 固定の設計値）
PG_HOST_PORT=5434
REDIS_HOST_PORT=6379
PGADMIN_HOST_PORT=5050
NGINX_HOST_PORT=8000

# pgAdmin ログイン
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-pgadmin

# メール受信箱（--profile mail のときだけ使う）
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
